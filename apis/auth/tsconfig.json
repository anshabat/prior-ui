{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*", "types/**/*.ts"],
  "exclude": ["node_modules"]
}
