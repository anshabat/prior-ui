{
  "name": "@workspace/config",
  "description": "Shared config between packages. Config which depend on environment",
  "version": "0.0.0",
  "scripts": {
    "build": "tsup"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  }
}
